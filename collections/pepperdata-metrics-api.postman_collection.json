  "item": [
    {
      "id": "1924eb52-0a3c-452b-a045-ac22dd8206b8",
      "name": "Metrics",
      "description": {
        "content": "Retrieve time-series metrics, series, and filters.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "a91a391b-2f23-4e3c-a007-c0d74e9f2fd8",
          "name": "Query metrics, series, and filters",
          "request": {
            "name": "Query metrics, series, and filters",
            "description": {
              "content": "Retrieve time-series metrics. Add breakdowns/filters with keys such as h (host), u (user), q (queue), c (control domain), j (job sequence id), tt (task type); use * for a full breakdown, a literal for a filter, or /regex/ for a regex match.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "m"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "s",
                  "value": "<string>",
                  "description": "(Required) Start time (YYYY/MM/DD-HH:mm)."
                },
                {
                  "disabled": false,
                  "key": "e",
                  "value": "<string>",
                  "description": "(Required) End time (YYYY/MM/DD-HH:mm)."
                },
                {
                  "disabled": false,
                  "key": "tzo",
                  "value": "<integer>",
                  "description": "Time zone offset from UTC in hours."
                },
                {
                  "disabled": false,
                  "key": "m",
                  "value": "<string>",
                  "description": "(Required) Metric to access (see Metric Definitions on the dashboard)."
                },
                {
                  "disabled": false,
                  "key": "sample",
                  "value": "<integer>",
                  "description": "Sample interval in ms (required if targetpoints not set). Minimum 5000."
                },
                {
                  "disabled": false,
                  "key": "targetpoints",
                  "value": "<integer>",
                  "description": "Target number of points (required if sample not set)."
                },
                {
                  "disabled": false,
                  "key": "ms",
                  "value": "20",
                  "description": "Maximum series to return (default 20)."
                },
                {
                  "disabled": false,
                  "key": "nohostsreporting",
                  "value": "<integer>",
                  "description": "Set to 1 to omit hostsreporting from the response."
                },
                {
                  "disabled": false,
                  "key": "omitpoints",
                  "value": "<string>",
                  "description": "Set to \"all\" to omit all datapoints."
                },
                {
                  "disabled": false,
                  "key": "downsampler",
                  "value": "<string>",
                  "description": "Set to \"percentile\" to split a single series into percentiles by time."
                },
                {
                  "disabled": false,
                  "key": "format",
                  "value": "json",
                  "description": "Response format."
                },
                {
                  "disabled": false,
                  "key": "omitaggregates",
                  "value": "<integer>",
                  "description": "Set to 1 to omit aggregate series."
                },
                {
                  "disabled": false,
                  "key": "dataonly",
                  "value": "<integer>",
                  "description": "Set to 1 to omit progress updates and instrumentation data."
                },
                {
                  "disabled": false,
                  "key": "h",
                  "value": "<string>",
                  "description": "Host breakdown/filter (* / literal / /regex/)."
                },
                {
                  "disabled": false,
                  "key": "u",
                  "value": "<string>",
                  "description": "User breakdown/filter."
                },
                {
                  "disabled": false,
                  "key": "q",
                  "value": "<string>",
                  "description": "Queue breakdown/filter."
                },
                {
                  "disabled": false,
                  "key": "c",
                  "value": "<string>",
                  "description": "Control-domain breakdown/filter."
                },
                {
                  "disabled": false,
                  "key": "j",
                  "value": "<string>",
                  "description": "Job-sequence-id breakdown/filter."
                },
                {
                  "disabled": false,
                  "key": "tt",
                  "value": "<string>",
                  "description": "Task-type breakdown/filter."
                }
              ],
              "variable": [
                {
                  "description": "Your Pepperdata realm/cluster name.",
                  "type": "any",
                  "value": "{{realm}}",
                  "key": "realm"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
